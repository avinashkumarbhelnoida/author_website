# Copy this into Netlify -> Site settings -> Environment variables.
# NEVER commit a real .env file with actual values to GitHub.

# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: Dashboard -> Settings -> API -> "service_role" (secret).
# This must ONLY ever exist as a Netlify environment variable, used inside
# netlify/functions/*.js. It must NEVER appear in any .html or .js file
# that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay ---
# Key ID is safe to expose to the browser (Checkout needs it).
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# Key Secret must ONLY exist as a Netlify environment variable, used inside
# netlify/functions/create-order.js and verify-payment.js.
RAZORPAY_KEY_SECRET=your-razorpay-secret
